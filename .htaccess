# WebGroceries shared-hosting front controller.
# Guna fail ini HANYA jika host tidak benarkan document root terus ke /public
# (cth. pelan percuma yang paksa guna htdocs/ atau public_html/).
# Perhatian: php -S tempatan abaikan fail ini, jadi ia selamat untuk dev.

<IfModule mod_rewrite.c>
RewriteEngine On

# Block sensitive paths from the web
RewriteRule ^(app|config|database|storage|deploy|vendor)/ - [F,L]
RewriteRule ^\.env - [F,L]

# Route everything into public/ (public/.htaccess takes over from there)
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ public/$1 [L]
</IfModule>

<FilesMatch "^\.env$">
Require all denied
</FilesMatch>
